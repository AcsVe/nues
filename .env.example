# انسخ هذا الملف إلى .env واضبط القيم. لا يُرفع .env إلى GitHub أبداً.
PORT=8110
# العنوان العام (للروابط في البريد)
BASE_URL=https://acs.edjo.win
# مجلد البيانات (القاعدة والمرفقات)؛ الافتراضي data داخل المشروع
# DATA_DIR=/opt/ras/ACS/data
# أول مدير يُنشأ عند أول تشغيل (أو استعمل: python ops/reset_password.py --create)
# ADMIN_USER=admin
# ADMIN_PASS=
# الهوية الافتراضية (تُغيَّر من لوحة التحكم ← الإعدادات)
# ORG_AR=الجمعية الثقافية العربية
# ORG_EN=Arab Cultural Society
# LOGO_URL=https://example.org/logo.png
# أيقونة تبويب المتصفح (PNG مربع) إن أردت أيقونة خاصة
# FAVICON_FILE=/opt/ras/acs-icon.png
# البريد عبر Microsoft 365 (نفس قيم بقية الأنظمة)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_EMAIL=
